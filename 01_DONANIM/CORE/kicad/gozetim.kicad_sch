	(text "(pusula ve IMU yakininda anahtarlama gurultusunu azaltir). Islemci sifirdayken girisler ic direncle sifirdadir: surucu kapali."
		(exclude_from_sim no)
		(at 30 236 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "15817bf3-759f-572b-bd58-fc1d871245f4")
	)
	(text "HARICI WATCHDOG (TPS3430): ana islemci WDG_KICK hattini 30-50 ms'de bir dusurur. Darbe kesilirse FMU_FAULT_N 200 ms sifira iner;"
		(exclude_from_sim no)
		(at 30 30 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "44707cff-55a6-549e-99c3-e1eda51e4121")
	)
	(text "IO islemcisi bunu gorur ve cikislari devralir. Watchdog ana islemciyi SIFIRLAMAZ (kendi ic watchdog'u sifirlar). Besleme: +3V3_IO."
		(exclude_from_sim no)
		(at 30 36 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "5f4e3e01-47cb-5f17-9335-df0687b24861")
	)
	(text "PELTIER SURUCUSU (DRV8837, 5 V, en cok 1 A): PWM_A isitir, PWM_B sogutur. Cikista bobin ve kondansator akimi duzlestirir"
		(exclude_from_sim no)
		(at 30 230 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "831bd184-bb7a-565a-b6f6-3d0640e7b289")
	)
	(text "ENERJI DEPOSU: 2 x 470 uF. Kesintiden sonra karti yaklasik 10-20 ms tasir (yuke bagli; olcumle dogrulanacak)."
		(exclude_from_sim no)
		(at 30 136 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "b46ae572-23aa-5700-a76c-dc9eb6cd832b")
	)
	(text "GUC KESINTISI ALGILAMA (TPS3808G01): giris 10,1 V altina inince PWR_FAIL_N sifira iner; islemci durumu FRAM'e yazar."
		(exclude_from_sim no)
		(at 30 130 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f1e5a5e1-7e60-5228-b0cb-a323d3bd8435")
	)
