	(text "DUGMELER (anlik basmali, 2 adet): 2 kontak = sinyal, GND. 10 k yukari cekme, 100 nF."
		(exclude_from_sim no)
		(at 30 430 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "386712b2-519a-53d5-9294-ff32e548abe2")
	)
	(text "Secilen gimbalin kendi kablosu bu siraya gore uyarlanir. Her giriste 1 k + 100 nF: suzme ve asiri gerilimde akim sinirlama."
		(exclude_from_sim no)
		(at 30 34 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "7deb8828-3e55-5907-9a89-f6c16c42736a")
	)
	(text "TEKERLEKLER (potansiyometre ya da Hall, analog): 3 kontak = +3V3A, sinyal, GND."
		(exclude_from_sim no)
		(at 30 120 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "7e3577f7-f28c-5a4f-8a40-1c7b390b74d8")
	)
	(text "bos 3,3 V; orta 0 V; yukari 0,60 V; asagi 1,06 V; sol 1,65 V; sag 2,27 V (10 k yukari cekme ile)."
		(exclude_from_sim no)
		(at 30 346 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "8562ffa0-1879-5faf-be6d-257ac197a8b9")
	)
	(text "YON TUSU (5 yonlu, menu icin): 6 kontak = GND, orta, yukari, asagi, sol, sag. Her yon farkli direncle tek analog girise baglanir:"
		(exclude_from_sim no)
		(at 30 340 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "912da097-2216-5030-800e-315b4417ab21")
	)
	(text "CUBUKLAR (Hall etkili gimbal, 3,3 V, eksen basina analog cikis): 4 kontak = +3V3A, X, Y, GND (bizim tanimimiz)."
		(exclude_from_sim no)
		(at 30 28 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "cfb7d899-424d-5b44-b8fd-b14b8b363981")
	)
	(text "orta konumda iki 47 k giris gerilimini yariya ceker. Tek analog giris uc konumu okur; kopuk kablo da 'orta' gorunur (ariza anlasilir)."
		(exclude_from_sim no)
		(at 30 206 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "e2f505a2-7bb5-54de-8ab2-07096936432b")
	)
	(text "ANAHTARLAR A-F (2 ya da 3 konumlu): 3 kontak = +3V3A, ortak uc, GND. Anahtar ortak ucu +3V3A'ya ya da GND'ye baglar;"
		(exclude_from_sim no)
		(at 30 200 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "e5e335a2-8716-5363-b46e-2b468570560e")
	)
