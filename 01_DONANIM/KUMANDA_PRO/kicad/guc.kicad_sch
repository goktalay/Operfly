	(text "CC1DB/CC2DB CC uclarina bagli: batarya bitikken de kaynak 5 V verir ve sarj baslar. Istenen gerilim/akim entegrenin kalici"
		(exclude_from_sim no)
		(at 30 34 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "1813a6e2-a000-5dbe-8d7b-2826d75da4c7")
	)
	(text "Batarya anahtari (SDRV): 'nakliye kipi'nde bataryayi tumuyle ayirir = KAPALI. Dugme (QON) ya da USB takilmasi yeniden acar."
		(exclude_from_sim no)
		(at 30 244 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "185d676c-b338-50d7-beff-63e7cae7ad6f")
	)
	(text "USB TYPE-C ve GUC ANLASMASI (STUSB4500, ureticinin ornek devresi): kaynakla 20 V'a kadar anlasir, sonra P kanal cift anahtari acar."
		(exclude_from_sim no)
		(at 30 28 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "2853fc09-7af3-5a98-a8b7-2555156fe8b7")
	)
	(text "GUC DUGMESI: sarj entegresinin QON ucuna baglidir (ic yukari cekme). Kapaliyken basinca batarya anahtari acilir ve kart calisir;"
		(exclude_from_sim no)
		(at 430 340 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "53e4ff05-7da6-5953-a6df-dba6a7eecb1e")
	)
	(text "Sicaklik bolucusu 5k23 / 30k1 (103AT sinifi 10 k NTC). Giris akimi siniri yazilimla ayarlanir (ILIM_HIZ = REGN: donanim siniri en yuksekte)."
		(exclude_from_sim no)
		(at 30 250 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "8da7f0d3-72d5-53c1-a70b-587e30f069f0")
	)
	(text "BATARYA (4 hucreli akilli Li-ion paket, kendi koruma ve olcer devresiyle; 5 kontak: +, SCL, SDA, sicaklik, -). Paketin olceri guc"
		(exclude_from_sim no)
		(at 430 215 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "96873c43-99b4-54a7-ab98-30e629ca1236")
	)
	(text "giris karti, sayisal devreler. 5 V: CAN alici-vericileri, sesli uyarici, 2. adimdaki USB portlari. Dugum ve Radio kartindaki devrelerin aynisi."
		(exclude_from_sim no)
		(at 430 446 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "a0fa9213-0ebb-58e8-abf2-fb55176267ab")
	)
	(text "3,3 V ve 5 V (AP63203 / AP63205, +VSYS'ten, 2 A): batarya bagliyken (nakliye kipi disinda) surekli aciktir. 3,3 V: guc islemcisi,"
		(exclude_from_sim no)
		(at 430 440 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "ab797c63-71d6-547d-b7cd-a0f0b9870c11")
	)
	(text "ayri ayri duyurur; islemciler gerilimsizken QON'u etkilemez. KAPATMA: guc islemcisi sarj entegresine 'nakliye kipi' komutu verir."
		(exclude_from_sim no)
		(at 430 352 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "b11de7ab-6e01-5f89-9952-2ba7e506f16e")
	)
	(text "PROG 27k = 4 hucre, 750 kHz. Sistem (+VSYS) girisle bataryadan hangisi varsa ondan beslenir; ikisi birlikteyken batarya destekler."
		(exclude_from_sim no)
		(at 30 238 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "e97ed9be-1f09-5cfc-9f44-f8d30605b911")
	)
	(text "bellegine uretimde I2C'den yazilir (hedef 20 V 3 A). VCHG: anahtardan sonraki sarj girisi (5-20 V)."
		(exclude_from_sim no)
		(at 30 40 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f139c2b6-dd64-51d9-a9dd-5c7af71f0dde")
	)
	(text "SARJ ve GUC YOLU (BQ25798, alcaltan-yukselten, 750 kHz, 2,2 uH): 5-20 V giristen 4 hucreli bataryayi sarj eder ve sistemi besler."
		(exclude_from_sim no)
		(at 30 232 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f1c0ef8a-b5ab-501f-a69e-7308fe034b0f")
	)
	(text "uzun basinca (yaklasik 10 s) entegre sistemi sifirlar (donanim sifirlamasi, yazilimdan bagimsiz). Cift diyot dugmeyi iki islemciye"
		(exclude_from_sim no)
		(at 430 346 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f5446de7-140f-5f47-b58f-ffffd53a45e6")
	)
	(text "islemcisinin I2C hattindadir. Batarya anahtari N kanal MOSFET: akaci bataryada, kaynagi sarj entegresinde (kapaliyken sisteme akim gecmez)."
		(exclude_from_sim no)
		(at 430 221 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "fb86f7a9-fb22-54d6-8e30-377cf2284127")
	)
