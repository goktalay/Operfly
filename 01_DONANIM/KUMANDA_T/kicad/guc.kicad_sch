	(text "SARJ ve GUC YOLU (BQ24075): USB varken sistemi USB'den besler ve bataryayi sarj eder; USB yokken bataryadan besler."
		(exclude_from_sim no)
		(at 330 120 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "97ae9c14-efda-56c6-90b0-3622fb413031")
	)
	(text "Esik 0,66 V. Standart kaynakta sarj entegresi 0,5 A giris sinirinda (EN2=0, EN1=1), 1,5 A / 3 A bildiren kaynakta"
		(exclude_from_sim no)
		(at 30 146 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "9cee14f2-d04f-5405-aec9-44b8ba8ec9d1")
	)
	(text "KAYNAK AKIMI ALGILAMA (LMV393): Type-C kaynagi verebildigi akimi CC gerilimiyle bildirir (standart < 0,61 V; 1,5 A > 0,70 V)."
		(exclude_from_sim no)
		(at 30 140 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "a9aabc34-acd9-5888-b86e-c1c4b2e30d43")
	)
	(text "BATARYA (tek hucreli Li-ion paket, koruma devreli, 10 k NTC'li): 3 kontak = +, NTC, -. Olcer icin 10 mOhm seri direnc."
		(exclude_from_sim no)
		(at 330 28 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "ae48a263-8ace-5881-aef7-d8baab50330a")
	)
	(text "islemci PWR_HOLD = 1 ile tutar, 0 yapinca kapanir. USB takiliyken SYSOFF kendiliginden sifirdadir (sarj islemciye bagli degil)."
		(exclude_from_sim no)
		(at 330 336 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "c69e6c4a-7ee8-5be0-9f83-9e71cdcc11d4")
	)
	(text "Cift diyot dugmeyi iki hatta ayri ayri baglar: kapaliyken giris kartindaki yukari cekme SYSOFF'u etkilemez."
		(exclude_from_sim no)
		(at 330 342 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
