	(text "RADYO BESLEMESI (TPS61230, yukselten): +SYS (3,0-5,5 V) -> 5,2 V. Modul verirken 1 A tepe ceker; entegre 3,3 V giristen 2,1 A verebilir."
		(exclude_from_sim no)
		(at 270 28 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "27775437-944e-5a09-98dd-22a943076d33")
	)
	(text "Besleme sifirlamada ACIKTIR; islemci RADIO_OFF = 1 ile keser. Devre ureticinin 5 V ornek devresidir."
		(exclude_from_sim no)
		(at 270 40 0)
		(effects
