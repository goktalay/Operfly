	(text "GUC KATI: giris tarafi 100 V, 8 mR MOSFET (ikiser adet); cikis tarafi 40 V, 1,4 mR MOSFET (aday). Hepsi 6 V kapi geriliminde tam acilan tipte olmali."
		(exclude_from_sim no)
		(at 30 250 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "3b82d025-5b24-56ee-ae11-978772ec285a")
	)
	(text "202 kHz, bobin 10 uH, akim direnci 4 mR, giris akim siniri 18 A (10 V altinda guc kendiliginden azalir)."
		(exclude_from_sim no)
		(at 30 34 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "45fac73b-3f56-5b92-b6c6-e148de8e1405")
	)
	(text "CIKIS: 12 V ana cikis XT60 ile Hub'a gider (150 W omurga fisinden gecmez). Omurga fisi 2 A sigortayla beslenir; dugum buradan calisir."
		(exclude_from_sim no)
		(at 30 370 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "a970401c-c196-5873-a7fa-d3ae4ab5e332")
	)
	(text "ILK TASLAK: kompanzasyon ve isil hesap benzetimle (LTspice) dogrulanmadan uretime gonderilmez."
		(exclude_from_sim no)
		(at 30 40 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "c48297d3-020a-5cd7-a0ed-ce5b06a72505")
	)
	(text "12 V CEVIRICI: ureticinin '12 V cikis, 4-80 V giris' ornek devresi 5 A'den 12,5 A'e olceklendi (150 W)."
