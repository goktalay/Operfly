	(text "MODUL BESLEMESI: 5 V, P kanal MOSFET ile anahtarli (islemci modulu kapatip acabilir), 0,5 A tutma akimli kendini onaran sigorta."
		(exclude_from_sim no)
		(at 20 125 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "0f296ac6-e78a-5308-9301-cfff53c6f7a2")
	)
	(text "Aday moduller ortalama 0,11-0,2 A, tepe 0,3 A ceker. Kapi kondansatoru acilisi yumusatir. SENS_VSENS = besleme / 2."
		(exclude_from_sim no)
		(at 20 131 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "2f6539f9-ce63-57c1-8364-83a761a0de38")
	)
	(text "MODUL KONNEKTORU (JST-GH 6, Operfly tanimi): 1 +5 V, 2 GND, 3 kart -> modul (modulun RX'i), 4 modul -> kart (modulun TX'i), 5 SCL / G-C, 6 SDA."
		(exclude_from_sim no)
		(at 20 22 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "86cbfb73-e861-5d20-99a6-f372cf27f189")
	)
	(text "Modulun kendi kablosu bu siraya gore hazirlanir. Hatlar 3,3 V seviyelidir; 470R seri direncler ve koruma diyotu kablo tarafindadir."
		(exclude_from_sim no)
		(at 20 28 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "af96a621-af3b-513d-8047-e12ab620e9c9")
	)
