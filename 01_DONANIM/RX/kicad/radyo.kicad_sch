	(text "ANTENLER: iki giris, modul iyi olani kendisi secer (cesitleme). Hatlar 50 ohm, dogrudan konnektore (uretici onerisi)."
		(exclude_from_sim no)
		(at 30 225 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "0f0e55dc-e106-52e0-827f-f63c5cd4b8af")
	)
	(text "BESLEME OLCUMU: islemci modul gerilimini okur (10 k / 10 k, 5,3 V -> 2,65 V)."
		(exclude_from_sim no)
		(at 270 170 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "0f14ce4c-786a-5d88-ac35-88d2782ee0c3")
	)
	(text "(3) islemci modulu kapatip acabilir (modulde sifirlama ucu yok). Cikis = 0,8 V x (1 + 169k / 30k1) = 5,29 V."
		(exclude_from_sim no)
		(at 270 40 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "32141e43-d211-57f0-b2b1-ce7b0caff72c")
	)
	(text "Ayri regulator: (1) gerilim alt sinirin ustunde kalir, (2) verici darbeleri dugumun 5 V rayini sarsmaz,"
		(exclude_from_sim no)
		(at 270 34 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "5c4876c8-3bd1-5056-a878-a5fc6a756b2b")
	)
	(text "Besleme sifirlamada ACIKTIR: islemci yeniden baslasa da radyo baglantisi kopmaz. Islemci RADIO_OFF = 1 ile keser."
		(exclude_from_sim no)
		(at 270 46 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "65a29d59-f1f9-5bc5-901c-93d8bd93c09e")
	)
	(text "Seri arayuz 3,3 V (en cok 3,5 V). USB uclari uretici tarafindan devre disi, bos. +3V3_OUT modulun kendi regulator cikisi, yuklenmez."
		(exclude_from_sim no)
		(at 30 34 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "83c0e119-e65d-588e-b3b2-407dcb3bfccf")
	)
	(text "MODUL BESLEMESI (AP63201, 12 V -> 5,3 V, 2 A, sabit frekansli): modul 5,0-5,5 V ister ve verirken 1 A tepe akim ceker."
		(exclude_from_sim no)
		(at 270 28 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "8d55d583-113f-5d6e-9f7f-e492b752a925")
	)
	(text "Islemciden module giden hatlarda 470R: modul beslemesi kapaliyken girislerinden akim akmasini sinirlar."
		(exclude_from_sim no)
		(at 30 40 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "d484b472-5875-5165-9f79-ac83227ccbe0")
	)
	(text "KUMANDA RADYO MODULU (RFDesign RFD900ux-SMT; 868 MHz icin RFD868ux-SMT ayni yere oturur). Uc sirasi uretici veri sayfasindan."
		(exclude_from_sim no)
		(at 30 28 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
