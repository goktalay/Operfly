	(text "FAN (5 V, 4 uclu: GND, +5V, devir, PWM): PWM Jetson'dan; Jetson kapaliyken 10k asagi cekme fani durdurur. Devir darbesi islemciye."
		(exclude_from_sim no)
		(at 380 230 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "21506a86-621a-57d5-b3cb-285ead0b40b1")
	)
	(text "IMU (ICM-42688-P, Jetson SPI0, 1,8 V): goruntu ile atalet olcumunu ayni saatle eslemek icin karta ozel IMU. INT1 -> GPIO09."
		(exclude_from_sim no)
		(at 380 28 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "74d29349-e58a-599d-82e0-e8effb9e5349")
	)
	(text "transistor GPIO00'i dusuge ceker (bilgisayar bagli). CC uclarinda 5k1: kart tuketicidir. VBUS karti beslemez."
		(exclude_from_sim no)
		(at 30 256 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "84671052-8153-5782-8c7e-c3ef58c3de5c")
	)
	(text "SEVIYE CEVIRICI (TXS0104E, 1,8 V <-> 3,3 V): Jetson UART1 <-> dugum islemcisi, omurga PPS'i -> GPIO07, fan PWM (GPIO14)."
		(exclude_from_sim no)
		(at 380 130 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "9a40c98b-5c5c-5917-8b38-2653942b18f4")
	)
	(text "PET uclari Jetson'in verici ciftlerine 220 nF uzerinden (Jetson sayfasinda) baglanir."
		(exclude_from_sim no)
		(at 30 34 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "9e07339c-d092-5ade-9f0f-e4fe8f4fba99")
	)
	(text "KURTARMA / YAZILIM YUKLEME USB'si (Type-C, Jetson USB0, aygit kipi): Jetson'a ilk yazilim bu porttan yuklenir. VBUS gelince"
		(exclude_from_sim no)
		(at 30 250 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "a14ed478-2f35-52cc-8b5a-2d5a92798360")
	)
	(text "M.2 NVMe (Key M, PCIE0, dort serit): 3,3 V ayri regulatorden. Soketin PER uclari Jetson'in alici ciftlerine dogrudan,"
		(exclude_from_sim no)
		(at 30 28 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "c32bb3fc-c6b9-5ca0-b20d-d0095519d3d0")
	)
	(text "Jetson kapaliyken (1,8 V yok) cevirici uclarini birakir; kart Jetson'a gerilim vermez."
		(exclude_from_sim no)
		(at 380 136 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f4332b26-ba91-55e6-a84f-46795dcb5373")
	)
