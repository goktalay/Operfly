	)
	(text "CAN FD: iki bagimsiz alici-verici (TJA1051-3). Sessiz mod girisi asagi cekili. Sonlandirma Hub'dadir; yerleri hazir, dizilmez."
		(exclude_from_sim no)
		(at 400 30 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "b90df782-00da-50bd-94d7-372f9416b139")
	)
	(text "GUVENLI ELEMAN (SE050): kart kimligi ve sertifikasi. SE_ENA sifira cekilince eleman kapanir (sifirlama)."
		(exclude_from_sim no)
		(at 400 150 0)
		(effects
			(font
