	)
	(text "BESLEME: 12 V -> 5 V (AP63205, 2 A) -> 3,3 V (LP5907, 250 mA). 3,3 V'ta daha fazla akim isteyen kart kendi regulatorunu ekler."
		(exclude_from_sim no)
		(at 30 125 0)
