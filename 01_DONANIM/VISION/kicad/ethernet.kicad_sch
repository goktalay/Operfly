	(text "I210: besleme tam tumlesik (1,5 V ve 0,9 V'u kendi uretir, CTOP-CBOT 39 nF), RSET 4k99, 25 MHz kristal + 27 pF, ayar icin SPI flash."
		(exclude_from_sim no)
		(at 30 137 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "00dc33d3-2c3c-54fd-8064-5a4d5c941e83")
	)
	(text "Kullanilmayan NC-SI, SMBus ve JTAG uclari uretici tablosundaki gibi cekilir. SDP1 <- omurga PPS'i, SDP0 -> kamera tetiklemesi."
		(exclude_from_sim no)
		(at 30 143 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "04a283bc-07d2-5306-9752-59b4e52412f1")
	)
	(text "KAMERA PORTLARI: her port ayri bir PCIe gigabit denetleyici (Intel I210-IT). Kamera akisi omurgayla ve diger kamerayla hat paylasmaz;"
		(exclude_from_sim no)
		(at 30 125 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "39d1e661-6276-5a7a-bc42-052cc66a2791")
	)
	(text "KAMERA PORTU 1 (PCIE1)"
		(exclude_from_sim no)
		(at 30 165 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left bottom)
		)
		(uuid "77715fce-cda6-5cf5-89d2-b013af25afd4")
	)
	(text "KAMERA PORTU 2 (PCIE2)"
		(exclude_from_sim no)
		(at 30 465 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left bottom)
		)
		(uuid "828f2b80-479c-54e4-a52c-de6e3f438cd1")
	)
	(text "her portta donanim zaman damgasi (PTP) vardir. Konnektor Operfly Bus'tir: 12 V (sigortali), Ethernet ve PPS (tetikleme). CAN baglanmaz."
		(exclude_from_sim no)
		(at 30 131 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "bf621aa4-9700-57b3-b390-7b7cb5b0bb93")
	)
	(text "OMURGA ETHERNET'I: Jetson'in kendi gigabit portu (PHY modulun icinde) trafo uzerinden omurga fisinin dort ciftine gider."
		(exclude_from_sim no)
		(at 30 25 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f7f2ea8e-83f0-5174-8c72-37b04b7b6b5f")
	)
