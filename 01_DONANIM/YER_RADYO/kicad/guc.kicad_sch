	(text "VEXT_SENS = giris gerilimi / 11 (islemci olcer). Kartin kendi +12V'u baradan ayri bir diyotla alinir (portlardan da beslenebilir)."
		(exclude_from_sim no)
		(at 30 40 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "0ee63191-d203-530c-bc30-583ed598e595")
	)
	(text "Her portun 12 V'u ayri, kendini onaran 2 A sigortadan gecer. Ethernet: 1. port = modulun LAN portu, 2. port = WAN portu (koprulenir);"
		(exclude_from_sim no)
		(at 30 156 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "3458ac17-e2ae-5e3d-b200-ca09202a73a9")
	)
	(text "18 V ustunu kirpma diyodu keser (surerse sigorta atar). +12V_BARA yer tarafinin ortak 12 V barasidir: kart ve dort port buradan beslenir."
		(exclude_from_sim no)
		(at 30 34 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "6b50ad96-e239-5ffb-a049-db4d3ddbedb9")
	)
	(text "3. ve 4. portlarda Ethernet yoktur (Base ve Tracker icin: CAN + 12 V)."
		(exclude_from_sim no)
		(at 30 162 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "82d8ed33-98a3-578d-a011-cefeb83e1d1c")
	)
	(text "DIS BESLEME GIRISI (XT30, 9-16 V: 3-4 hucreli batarya ya da 12 V adaptor). Sigorta 7 A; ters baglantida ve geri beslemede diyot keser,"
