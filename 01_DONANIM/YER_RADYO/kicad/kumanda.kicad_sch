	(text "Islemciden module giden hatlarda 470R: modul beslemesi kapaliyken girislerinden akim akmasini sinirlar. GPIO uclari kullanilmaz."
		(exclude_from_sim no)
		(at 30 40 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "364a2b33-3260-567c-af0c-53b1f1691c98")
	)
	(text "BESLEME OLCUMU: islemci modul gerilimini okur (10 k / 10 k, 5,3 V -> 2,65 V)."
		(exclude_from_sim no)
		(at 270 170 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "5f376f80-4d6b-56e1-a19f-c09403032141")
	)
	(text "Seri arayuz 3,3 V (en cok 3,5 V). USB uclari uretici tarafindan devre disi, bos. +3V3_OUT modulun kendi regulator cikisi, yuklenmez."
		(exclude_from_sim no)
		(at 30 34 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "656a06db-e269-52aa-a71a-df85f20c0191")
	)
	(text "MODUL BESLEMESI (AP63201, 12 V -> 5,3 V; RX kartindaki devre): modul 5,0-5,5 V ister ve verirken 1 A tepe akim ceker."
		(exclude_from_sim no)
		(at 270 28 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "a697aae7-be33-596b-bb57-6b112deda4b6")
	)
	(text "Besleme sifirlamada ACIKTIR; islemci KUM_OFF = 1 ile keser (modulde sifirlama ucu yok). Cikis = 0,8 V x (1 + 169k / 30k1) = 5,29 V."
		(exclude_from_sim no)
		(at 270 34 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "de880c32-6208-5c81-bba3-a10ebe4fca50")
	)
	(text "ANTENLER: iki giris, modul iyi olani kendisi secer (cesitleme). Hatlar 50 ohm, dogrudan konnektore (uretici onerisi)."
		(exclude_from_sim no)
		(at 30 225 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "e047c99f-eae6-5eb8-86f0-0d444f145a1a")
	)
	(text "KUMANDA RADYO MODULU (RFDesign RFD900ux-SMT; 868 MHz icin RFD868ux-SMT ayni yere oturur): RX kartindaki baglantinin aynisi."
